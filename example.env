# ==============================================================================
# Hermes Brain Command Deck — Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and configure your API credentials, directories & service URLs:
#   cp example.env .env
#
# All settings configured here are loaded directly by the backend and can also
# be edited and saved live from the "Settings" page in the dashboard.
# Both primary keys and their listed aliases are automatically recognized and synced.
# ==============================================================================

# ==============================================================================
# 0. STORAGE & DIRECTORY LAYOUT (Settings Page -> Storage & Paths)
# ==============================================================================
# Base Hermes installation directory (defaults: ~/.hermes on Linux/macOS, %LOCALAPPDATA%\hermes on Windows)
HERMES_HOME=
# Root data directory for Hermes Brain state, memory, and databases (defaults to HERMES_HOME)
HERMES_DATA_DIR=
# SQLite Personal Organizer database path
ORGANIZER_DB_PATH=
# Active wiki markdown repository path
ACTIVE_WIKI_PATH=
# Oracle cognitive brain / notes path
ORACLE_BRAIN_PATH=
# Automated system & state backup destination directory
BACKUP_ROOT_DIR=
# Inter-agent exchange & artifacts directory
EXCHANGE_DIR=

# ==============================================================================
# 1. OPERATOR & AI INFERENCE CONFIGURATION (Settings Page -> AI & Speech)
# ==============================================================================

# Operator Identity
HERMES_OPERATOR_NAME=Operator

# Primary LLM Inference Provider
# Options: openrouter, openai, anthropic, ollama, llamacpp, vllm, lmstudio, custom
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4
LLM_CONTEXT_WINDOW=32768
LLM_TEMPERATURE=0.2

# Vision & Multimodal Provider (Optional, defaults to primary LLM if empty)
VISION_PROVIDER=
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# Speech-to-Text (STT) Engine
# Options: openai_compatible, openai, deepgram, groq, local
STT_PROVIDER=openai_compatible
STT_BASE_URL=http://localhost:8000/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Text-to-Speech (TTS) Engine
# Options: edge (free built-in, no API key required), elevenlabs, openai, openai_compatible, neutts
TTS_PROVIDER=edge
TTS_BASE_URL=http://localhost:8000/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=en-US-AriaNeural

# ElevenLabs Neural Voice (Optional fallback)
ELEVENLABS_API_KEY=

# Local Speech-to-Speech Gateway
VOICE_GATEWAY_URL=http://localhost:8000
VOICE_GATEWAY_PORT=8000
VOICE_PROVIDER=openai_compatible
VOICE_MODEL=whisper-1
VOICE_TTS_VOICE=alloy
VOICE_API_KEY=

# ==============================================================================
# 2. POSTGRESQL + PGVECTOR SEMANTIC MEMORY (Settings Page -> PostgreSQL & Vector Store)
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=brain
POSTGRES_PASSWORD=brain
POSTGRES_DB=brain
# Full database URL (synthesized or overridden; alias: DATABASE_URL)
PG_URL=postgresql://brain:brain@localhost:5433/brain

# ==============================================================================
# 3. BRAIN VECTOR EMBEDDINGS & COGNITIVE SYNC (Settings Page -> Brain Embeddings)
# ==============================================================================
# Embedding server for brain-postgres sync (Ollama / llama.cpp / OpenAI-compatible)
BRAIN_OLLAMA_URL=http://localhost:11434
# Embedding model identifier
BRAIN_EMBED_MODEL=nomic-embed-text
# API mode: ollama (native /api/embeddings) or openai (/v1/embeddings)
BRAIN_API_MODE=ollama
# Chunking parameters
BRAIN_CHUNK_TOKENS=400
BRAIN_CHUNK_OVERLAP=80
# Backward-compatibility alias for embed node
INFERENCE_EMBED_URL=http://localhost:11434

# ==============================================================================
# 4. DISTRIBUTED LOCAL INFERENCE CLUSTER NODES (Settings Page -> Local Inference Cluster)
# ==============================================================================
# Node 1 (Main Reasoning): llama.cpp server / Ollama (Hermes 3 Llama-70B)
INFERENCE_NODE_MAIN=http://localhost:8080
# Node 2 (Vision & Fast Code): LM Studio (Qwen 2.5 VL)
INFERENCE_NODE_VISION=http://localhost:1234
# Node 3 (vLLM Engine): vLLM batched inference
INFERENCE_NODE_VLLM=http://localhost:18020
# Optional cluster bearer token (leave blank if unauthenticated)
INFERENCE_API_KEY=

# ==============================================================================
# 5. MODEL ROLE OVERRIDES (Settings Page -> Model Roles)
# Leave empty to use the primary LLM (LLM_*) for that role.
# ==============================================================================
MODEL_ROLE_NEWSLETTER_PROVIDER=
MODEL_ROLE_NEWSLETTER_BASE_URL=
MODEL_ROLE_NEWSLETTER_API_KEY=
MODEL_ROLE_NEWSLETTER_MODEL=
MODEL_ROLE_RESEARCH_PROVIDER=
MODEL_ROLE_RESEARCH_BASE_URL=
MODEL_ROLE_RESEARCH_API_KEY=
MODEL_ROLE_RESEARCH_MODEL=
MODEL_ROLE_ORACLE_PROVIDER=
MODEL_ROLE_ORACLE_BASE_URL=
MODEL_ROLE_ORACLE_API_KEY=
MODEL_ROLE_ORACLE_MODEL=
MODEL_ROLE_EMBEDDING_PROVIDER=
MODEL_ROLE_EMBEDDING_BASE_URL=
MODEL_ROLE_EMBEDDING_API_KEY=
MODEL_ROLE_EMBEDDING_MODEL=

# ==============================================================================
# 6. MULTI-CHANNEL NOTIFICATIONS & ALERTS (Settings Page -> Notifications)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL_TO=

# ==============================================================================
# 7. HOMELAB & AUTOMATION SERVICES (Settings Page -> Automation & Homelab)
# ==============================================================================
# n8n Workflow Automation Engine
N8N_URL=http://127.0.0.1:5678
N8N_API_KEY=
N8N_MCP_TOKEN=

# Home Assistant Smart Home
HASS_URL=http://127.0.0.1:8123
HASS_TOKEN=
HASS_MCP_TOKEN=

# SearXNG Private Metasearch Engine
SEARXNG_URL=http://127.0.0.1:8080

# ==============================================================================
# 8. EXTERNAL NAVBAR LINKS & HOMELAB APPS (Settings Page -> Section 2 & 3)
# ==============================================================================
DEERFLOW_URL=http://localhost:8000
DEERFLOW_API_KEY=

VANE_URL=http://localhost:3000
VANE_API_KEY=

OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_API_KEY=

AUDIOBOOKSHELF_URL=http://localhost:13378
AUDIOBOOKSHELF_TOKEN=

BOOKLORE_URL=http://localhost:8080
BOOKLORE_API_KEY=

IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=

NEXTCLOUD_URL=http://localhost:8080
NEXTCLOUD_USER=admin
NEXTCLOUD_TOKEN=

SEER_URL=http://localhost:5055
SEER_API_KEY=

FRESHRSS_URL=http://localhost:8080
FRESHRSS_USER=admin
FRESHRSS_API_KEY=

GODS_EYE_URL=http://localhost:5173
GODS_EYE_API_KEY=

UPTIME_KUMA_URL=http://localhost:3001
UPTIME_KUMA_SLUG=default
UPTIME_KUMA_TOKEN=

# Media Server Services (Active Streams & Queue Monitoring)
JELLYFIN_TOKEN=
SONARR_API_KEY=
RADARR_API_KEY=

# Hermes Gateway API (Optional external proxy)
HERMES_GATEWAY_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# ==============================================================================
# 9. FINANCIAL MARKET DATA APIS (Settings Page -> Section 3)
# ==============================================================================
ALPHAVANTAGE_API_KEY=
MASSIVE_API_KEY=
MASSIVE_API_URL=https://api.massive.com/v1
FINNHUB_API_KEY=
FMP_API_KEY=
TWELVEDATA_API_KEY=
FRED_API_KEY=

# ==============================================================================
# 11. HONCHO STACK (docker/docker-compose.honcho.yml)
# ------------------------------------------------------------------------------
# Honcho provides the autobiographical / user-model memory tier. The compose
# file declares these as REQUIRED (${HONCHO_PG_PASSWORD:?...}), so a fresh
# install must have them or `docker compose -f docker/docker-compose.honcho.yml
# up` aborts before creating anything.
#
# HONCHO_PG_PASSWORD is NOT set here on purpose. install.py's ensure_env_file()
# generates it into the single repo-root .env (mode 600, gitignored) and passes
# that file to every compose stack with --env-file, so a fresh install deploys
# Honcho without anyone editing a file. Set it in the Control Panel
# (Settings -> Honcho) or edit the root .env to use your own value.
#
# Shipping a literal default here was how the old `HONCHO_PG_PASSWORD=honcho`
# got into an install: a real credential-shaped default in a tracked file,
# which is the thing this project exists to avoid.
# ==============================================================================
HONCHO_PG_USER=honcho
HONCHO_PG_DB=postgres
HONCHO_VERSION=latest
PG_VERSION=16
REDIS_VERSION=7

# SearXNG instance key (docker/docker-compose.searxng.yml). A default is
# provided inline so the stack starts; change it for any shared deployment.
SEARXNG_SECRET=
SEARXNG_VERSION=latest
VALKEY_VERSION=8

# ==============================================================================
# 12. COMPANION APPLICATIONS & SERVER PORTS (Settings Page -> Server Ports)
# ==============================================================================
DASHBOARD_PORT=8088
AI_VISUALIZER_PORT=8002
AI_VISUALIZER_DIR=ai-visualizer
BAREHANDS_PORT=8003
BAREHANDS_DIR=barehands

# Remote Deployment & Mesh Targets (Optional)
ORACLE_CLOUD_IP=
WG_HOSTNAME=
WG_ADMIN_PASSWORD=

# ── Honcho (self-hosted) ──────────────────────────────────────────────────────
# Licence: AGPL-3.0. Self-hosting it yourself carries no obligation; shipping it
# inside a distributed product, or offering it as a hosted service, does. See
# docs/MEMORY-SUBSYSTEM-EVALUATION.md before making that call for your project.
#
# The deriver (background memory derivation) needs an LLM. Every LLM subsystem
# accepts a per-module BASE_URL override, and Ollama / vLLM / LiteLLM are supported,
# so the whole memory stack can run locally at zero API cost:
#
#   DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=http://localhost:11434/v1
#   DERIVER_MODEL_CONFIG__MODEL=<your-local-llama-model>
#
# Leave the API keys below empty when using a local endpoint.
# LLM_GEMINI_API_KEY=
# LLM_ANTHROPIC_API_KEY=
# LLM_OPENAI_API_KEY=

# ─── Firecrawl web stack ──────────────────────────────────────────────────────
# AGPL-3.0. Bundled as a separate container, not vendored -- see
# docs/THIRD-PARTY-LICENSES.md. Five services (API, Playwright, Redis,
# RabbitMQ, NUQ Postgres). Upstream's own compose budgets 2 CPUs/4 GB for
# Playwright and 4 CPUs/8 GB for the API, so budget ~6 CPU and 12 GB before
# tuning. Self-hosted Firecrawl is NOT feature-equivalent to the hosted
# service: agent, browser, interact, screenshots and page actions are
# Cloud-only, and the fire-engine anti-bot layer is not in the OSS stack.
# Pin versions -- upstream ships hundreds of tags and tracks `latest` fast.
FIRECRAWL_VERSION=v2.11.162
PLAYWRIGHT_SERVICE_VERSION=v1.3.0
NUQ_POSTGRES_TAG=latest

# Credentials. All three are required for the stack to come up cleanly; an
# unset or mismatched password produces ACCESS_REFUSED from nuq-worker with
# a misleading symptom (the API starts, then every job fails).
FC_PG_USER=firecrawl
FC_PG_PASS=change-me-firecrawl-pg
FC_RABBITMQ_PASS=change-me-firecrawl-rabbit
FC_API_KEY=change-me-firecrawl-api

# CamoFox browser automation (stealth browsing, separate from Playwright)
CAMOFOX_VERSION=latest
CAMOFOX_API_KEY=change-me-camofox

# Tunables. These are upstream's own defaults; lower them on a small host.
# Firecrawl is the single most memory-hungry service in the stack.
CRAWL_CONCURRENT_REQUESTS=10
NUM_WORKERS_PER_QUEUE=4
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5
LOGGING_LEVEL=warn

# Search routing. This stack does NOT deploy SearXNG; it connects to an
# existing instance. Note that search engines block, CAPTCHA, rate-limit and
# sometimes return nothing at all, so treat "SearXNG is up" as very different
# from "search works". See docs/DEPENDENCY-AUDIT.md.
FC_SEARXNG_ENDPOINT=http://searxng-core:8080
FC_SEARXNG_NETWORK=hermes-searxng_searxng-net
FC_SEARXNG_CATEGORIES=
SEARXNG_ENGINES=google,bing,duckduckgo,wikipedia,github
