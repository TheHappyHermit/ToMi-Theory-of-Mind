# Per-profile runtime state, for every profile, including ones added later.
# ~/.hermes/profiles/<name> is symlinked into the repo, so the cron ticker and
# session store write straight into the working tree. The per-profile rules
# below only cover the profiles that existed when they were written; this
# catches new ones (locks, heartbeat files, execution dbs, job output) so a
# fresh profile cannot leak runtime state into a commit.
profiles/*/cron/
profiles/*/sessions/
profiles/*/logs/
profiles/*/cache/
profiles/*/runtime/
profiles/*/state-snapshots/
profiles/*/sandboxes/
profiles/*/memories/
profiles/*/image_cache/
profiles/*/audio_cache/
profiles/*/pairing/
profiles/*/auth.lock
profiles/*/.backup.lock

