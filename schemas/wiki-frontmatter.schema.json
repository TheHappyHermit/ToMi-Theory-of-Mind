{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-brain.local/schemas/wiki-frontmatter.schema.json",
  "title": "Wiki frontmatter (OKF v0.2) \u2014 GENERATED MIRROR",
  "description": "Derived from schemas/okf-schema.yaml by scripts/okf_export_json.py. DO NOT EDIT BY HAND. The YAML is the single source of truth; if this file disagrees with it, the YAML is correct.",
  "type": "object",
  "required": [
    "okf_version",
    "id",
    "type",
    "status",
    "description",
    "generated",
    "tags",
    "sources",
    "confidence"
  ],
  "additionalProperties": true,
  "properties": {
    "okf_version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "enum": [
        "profile",
        "person",
        "project",
        "decision",
        "system",
        "asset",
        "purchase",
        "trip",
        "routine",
        "idea",
        "question",
        "lesson",
        "reference",
        "incident",
        "index",
        "research-report",
        "paper",
        "preprint",
        "conference",
        "journal",
        "technical-spec",
        "presentation",
        "model-card",
        "comparison",
        "entity",
        "code",
        "log",
        "evergreen",
        "temporal"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "stable",
        "deprecated",
        "active",
        "current",
        "waiting",
        "blocked",
        "completed",
        "cancelled",
        "disputed",
        "superseded",
        "stale",
        "unverified",
        "archived"
      ]
    },
    "description": {
      "type": "string"
    },
    "generated": {
      "type": "object",
      "required": [
        "by",
        "at"
      ],
      "properties": {
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "description": "RFC3339 UTC, e.g. 2026-09-26T14:03:00Z"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "ungraded",
        "not_applicable"
      ]
    },
    "title": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "epistemic": {
      "type": "string",
      "enum": [
        "fact",
        "observation",
        "explicit-preference",
        "verified-inference",
        "hypothesis",
        "prediction",
        "decision"
      ]
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_after": {
      "type": "string",
      "format": "date"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_after": {
      "type": "string",
      "format": "date"
    },
    "supersedes": {
      "type": "string"
    },
    "superseded_by": {
      "type": "string"
    },
    "provenance": {
      "type": "string"
    },
    "arxiv_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    }
  },
  "x-canonical-source": "schemas/okf-schema.yaml",
  "x-okf-version": "0.2"
}
